{
  "functions": {
    "api/delete-account.ts": { "runtime": "nodejs20.x" },
    "api/openai.ts": { "runtime": "nodejs20.x" }
  },
  "rewrites": [
    { "source": "/cc-api/:path*",      "destination": "https://min-api.cryptocompare.com/:path*" },
    { "source": "/okx-api/:path*",     "destination": "https://www.okx.com/:path*" },
    { "source": "/bybit-api/:path*",   "destination": "https://api.bybit.com/:path*" },
    { "source": "/bnf-api/:path*",     "destination": "https://fapi.binance.com/:path*" },
    { "source": "/coinbase-api/:path*","destination": "https://api.international.coinbase.com/:path*" },
    { "source": "/gecko-api/:path*",  "destination": "https://api.coingecko.com/:path*" }
  ]
}
