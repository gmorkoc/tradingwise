# RevenueCat public SDK key (Project settings -> API keys -> Apple App
# Store, in the RevenueCat dashboard). iOS in-app purchases stay fully
# inactive — UpgradeModal falls back to Stripe checkout — until this is set.
VITE_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_sdk_key_here
