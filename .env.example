VITE_COINGLASS_API_KEY=your_coinglass_hobbyist_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# RevenueCat public SDK key (Project settings -> API keys -> Apple App
# Store, in the RevenueCat dashboard). iOS in-app purchases stay fully
# inactive — UpgradeModal falls back to Stripe checkout — until this is set.
VITE_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_sdk_key_here

# Web Push VAPID public key (safe to expose client-side — the private half
# lives only as the VAPID_PRIVATE_KEY Supabase Edge Function secret).
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
